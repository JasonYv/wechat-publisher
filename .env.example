# 管理后台
APP_NAME=公众号内容台
APP_SUBTITLE=WeChat Publisher
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# 外部发布 API（独立于后台登录；至少 32 个随机字符）
PUBLISH_API_KEY=replace-with-a-separate-publish-api-key

# 微信公众号（仅服务端读取，禁止添加 NEXT_PUBLIC_ 前缀）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ACCOUNT_NAME=你的公众号名称
WECHAT_AUTHOR=
WECHAT_CONTENT_SOURCE_URL=

# 单机 SQLite
DATABASE_PATH=./data/wechat-publisher.db
UPLOAD_DIR=./uploads
